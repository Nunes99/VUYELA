# Public site URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser-safe values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PHONE_AUTH_ENABLED=false

# Future audited platform operations only. Current user flows do not require this key.
# Never expose this server-only credential to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Future email channel. Leave unset until notifications are implemented.
RESEND_API_KEY=
