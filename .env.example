# Public site URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase browser-safe values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_PHONE_AUTH_ENABLED=false

# Future audited platform operations only. Current user flows do not require this key.
# Never expose this server-only credential to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Notification delivery worker. Keep every value server-only.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=VUYELA <notificacoes@example.com>
CRON_SECRET=
